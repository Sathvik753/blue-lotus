# ── Copy this to .env and fill in values ──────────────────────
# Never commit .env to git.

# --- Core -----------------------------------------------------------------
# Database. Local dev falls back to SQLite if unset. Railway/Render/Cloud SQL
# hand out a postgres:// URL, which the app rewrites to asyncpg automatically.
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/bluelotus

# JWT signing secret — REQUIRED in production. Generate with:
#   openssl rand -hex 32
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32

# "production" turns on HSTS, hides error internals, and refuses to boot with
# the insecure default SECRET_KEY.
ENV=development

# Comma-separated list of allowed browser origins (your frontend URL). When set,
# CORS is locked to these; leave blank only for local dev.
ALLOWED_ORIGINS=https://your-frontend-url

# Requests per minute per IP before 429 (baseline rate limit).
RATE_LIMIT_PER_MINUTE=120

# --- Developer mode -------------------------------------------------------
# Emails granted access to the /developer console and /dev/* API. Comma-sep.
DEVELOPER_EMAILS=you@yourfirm.com

# Access code that unlocks the developer role from the /developer page.
# Developers bypass rate limits and run quotas. Leave blank to disable the
# unlock endpoint entirely. Never commit the real code.
DEVELOPER_UNLOCK_CODE=

# --- Billing (Stripe) -----------------------------------------------------
# Leave STRIPE_SECRET_KEY blank to run billing in MOCK mode (plans switch
# instantly, no charges). Fill these in to take live payments — no code change.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=price_xxx          # Stripe Price ID for the $1k/mo Pro plan
STRIPE_PRICE_ENTERPRISE=price_xxx   # (optional) Enterprise Price ID
APP_BASE_URL=http://localhost:3000  # used for Stripe success/cancel redirects

# --- Frontend build-time --------------------------------------------------
# Baked into the React build; points the SPA at the API.
REACT_APP_API_BASE=http://localhost:8000
